generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

enum ImageStatus {
  active
  pending

  @@map("imageStatus")
  @@schema("public")
}

model User {
  id         String    @id @default(uuid())
  first_name String
  last_name  String
  email      String    @unique
  password   String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  sessions   Session[]

  @@map("users")
  @@schema("auth")
}

model Session {
  id         String   @id @default(uuid())
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
  @@schema("auth")
}

model Work {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  content     String
  description String
  image_url   String
  image_id    String
  badge       String[]
  is_selected Boolean  @default(false)
  hover_text  String
  image       Image    @relation(fields: [image_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("works")
  @@schema("public")
}

model Image {
  id         String      @id @default(uuid())
  file_path  String
  file_name  String
  mime_type  String
  status     ImageStatus @default(pending)
  created_at DateTime    @default(now())
  works      Work[]

  @@map("images")
  @@schema("public")
}

